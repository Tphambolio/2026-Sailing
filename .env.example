VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional — enables the "Browse Google Photos" picker in the Journal tab.
# Google Cloud Console: enable the "Google Photos Picker API", configure the
# OAuth consent screen (Testing is fine for personal use), then create an
# OAuth Client ID (Web application) with this site as an authorized
# JavaScript origin. The feature is hidden entirely if this is unset.
VITE_GOOGLE_CLIENT_ID=your_oauth_client_id

# Optional — gates the whole site behind a shared password (deters casual
# visitors, not a determined attacker). Set to the SHA-256 hex digest of the
# real password, never the plaintext. Generate with:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword')).then(b => console.log(Buffer.from(b).toString('hex')))"
# Unset means the gate is off — keeps local dev unlocked by default.
VITE_SITE_PASSWORD_HASH=your_password_sha256_hash
