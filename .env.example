VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional — enables the "Browse Google Photos" picker in the Journal tab.
# Google Cloud Console: enable the "Google Photos Picker API", configure the
# OAuth consent screen (Testing is fine for personal use), then create an
# OAuth Client ID (Web application) with this site as an authorized
# JavaScript origin. The feature is hidden entirely if this is unset.
VITE_GOOGLE_CLIENT_ID=your_oauth_client_id
